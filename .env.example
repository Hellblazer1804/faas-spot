# ==============================================================
# FaaSpot Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================

# --------------------------------------------------------------
# MySQL / Database
# Required by: all components
# --------------------------------------------------------------
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=

# --------------------------------------------------------------
# Fission Router
# NodePort URL of your Fission router service.
# Required by: test-runner, retry-manager, load-generator
# --------------------------------------------------------------
ROUTER_BASE_URL=http://localhost:32363

# --------------------------------------------------------------
# Request Recorder
# Required by: load-generator/msft-loadgen.py only
# --------------------------------------------------------------
REQUEST_RECORDER_URL=http://localhost:5001

# --------------------------------------------------------------
# Discord Webhook (optional — leave blank to disable)
# Create at: Server Settings > Integrations > Webhooks
# Required by: test-runner/discord/
# --------------------------------------------------------------
DISCORD_WEBHOOK_URL=

# --------------------------------------------------------------
# Experiment metadata
# --------------------------------------------------------------
EXPERIMENT_TAG=main_experiment

# ==============================================================
# Kubernetes deployment note:
# retry-manager/kube/deployment.yaml reads MySQL credentials
# from a Kubernetes Secret (keys: mysql-host, mysql-user,
# mysql-password, mysql-db). Create that Secret separately
# before deploying — see docs/retry-manager.md.
# ==============================================================
