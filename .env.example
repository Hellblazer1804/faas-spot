# ==============================================================
# FaaSpot Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================

# --------------------------------------------------------------
# MySQL / Database
# Required by: all components
# --------------------------------------------------------------
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=

# --------------------------------------------------------------
# Fission Router
# NodePort URL of your Fission router service.
# Required by: test-runner, retry-manager, load-generator
# --------------------------------------------------------------
ROUTER_BASE_URL=http://localhost:32363

# --------------------------------------------------------------
# Request Recorder
# Required by: load-generator/msft-loadgen.py only
# --------------------------------------------------------------
REQUEST_RECORDER_URL=http://localhost:5001

# --------------------------------------------------------------
# Discord Webhook (optional — leave blank to disable)
# Create at: Server Settings > Integrations > Webhooks
# Required by: test-runner/discord/
# --------------------------------------------------------------
DISCORD_WEBHOOK_URL=

# --------------------------------------------------------------
# Experiment metadata
# --------------------------------------------------------------
EXPERIMENT_TAG=main_experiment

# --------------------------------------------------------------
# Workflow Behavior
# These parameters tune retry, scaling, and budget behavior.
# All components read from here — set once, applies everywhere.
# --------------------------------------------------------------

# Target fraction of requests that must succeed (0.0–1.0).
# Lower values (e.g. 0.70) mean the scaler/retry service accepts
# more failures before intervening; higher values (e.g. 0.95)
# trigger more aggressive recovery. Default: 0.85.
WF_TARGET_SUCCESS_RATE=0.85

# Maximum retry attempts per workflow UID before giving up.
WF_MAX_RETRIES=20

# Exponential backoff parameters for the retry service.
WF_MIN_BACKOFF_SEC=10
WF_MAX_BACKOFF_SEC=240
WF_BACKOFF_MULTIPLIER=1.3

# Budget for the adaptive scaler, as a fraction of estimated
# on-demand cost. E.g. 0.50 = spend at most 50% of what
# on-demand would cost.
WF_BUDGET_PERCENT=0.50

# Estimated experiment runtime (hours) and machine count —
# used to calculate the absolute budget ceiling.
WF_ESTIMATED_RUNTIME_HOURS=1.5
WF_ESTIMATED_MACHINES=8

# Scaler cold-start: minutes the scaler stays idle at startup
# to let the retry service handle early failures first.
WF_COLD_START_MINUTES=5

# ==============================================================
# Kubernetes deployment note:
# retry-manager/kube/deployment.yaml reads MySQL credentials
# from a Kubernetes Secret (keys: mysql-host, mysql-user,
# mysql-password, mysql-db). Create that Secret separately
# before deploying — see docs/retry-manager.md.
# ==============================================================
